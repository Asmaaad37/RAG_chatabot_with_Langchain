# Copy this file to .env and fill in your values:
#   copy .env.example .env      (Windows)
# Never commit your real .env file - it is listed in .gitignore.

# --- You ---
# Your first name, for the "Welcome back, <name>" greeting. Leave empty for just "Welcome back".
USER_NAME=

# --- Groq (LLM) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Any chat model from https://console.groq.com/docs/models
# (Groq retired its free Llama models in Aug 2026; gpt-oss-20b is their recommended replacement.)
GROQ_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.2
# Speech-to-text for the mic button (also free on Groq)
WHISPER_MODEL=whisper-large-v3-turbo

# --- Embeddings (runs locally, no key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking (sizes are in characters) ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=5
# Cosine similarity from 0 to 1. Below this, the app answers "I couldn't find this in your documents".
SCORE_THRESHOLD=0.55
# Hybrid search = meaning-based search + keyword (BM25) search. Better for names, numbers, acronyms.
HYBRID_SEARCH=true
# The reranker rescores the top RERANK_CANDIDATES chunks with a cross-encoder (local, ~90 MB).
# Ranks answers higher and rejects off-topic questions reliably; adds ~1.3 s per question on a CPU.
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
# A chunk is used if its similarity >= SCORE_THRESHOLD *or* its reranker score >= RERANK_THRESHOLD.
RERANK_THRESHOLD=0.1

# --- Chat ---
# How many previous question/answer pairs are sent along so follow-up questions work.
HISTORY_TURNS=3

# --- Misc ---
LOG_LEVEL=INFO
